FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...",...}
# The NAMED Firestore database. Must belong to the same project as the key
# above, or every read fails with 5 NOT_FOUND. Defaults to "omimpex".
FIRESTORE_DATABASE_ID=omimpex
API_KEY=a-long-random-secret-shared-with-the-AIM-app-only
